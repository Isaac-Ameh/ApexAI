# Local UI preview uses PGLite and auth-off dev mode by default.
VITE_AUTH_ENABLED=false

# Optional: use a real Postgres/Neon database instead of local PGLite.
# DATABASE_URL=

# Optional: enable tutor, quiz, and course-mapping generation.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_FREE_MODEL=openai/gpt-oss-20b
# AI_PAID_MODEL=openai/gpt-oss-120b

# Optional: enable semantic embeddings and listen/TTS.
# XAI_API_KEY=
